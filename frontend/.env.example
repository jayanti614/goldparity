# For local development, leave this file as-is / unset. Vite's dev-server
# proxy (see vite.config.js) automatically forwards /api requests to the
# backend running on http://127.0.0.1:8000 -- no configuration needed.
#
# For a PRODUCTION deployment (e.g. on Vercel), this needs to be set to
# your deployed backend's real URL, with /api on the end, e.g.:
# VITE_API_BASE_URL=https://goldparity-api.onrender.com/api
#
# Set this in Vercel's project settings under "Environment Variables" --
# not by editing this file (Vercel doesn't read .env files from the repo
# for security reasons; this file is just documentation).
VITE_API_BASE_URL=
